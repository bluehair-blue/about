{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "about",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "dist/client"
  },
  "routes": [
    {
      "pattern": "about.bluehair.blue",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  }
}
